# Copy this file to .env and fill in your values.
# Load it before starting: set -a && source .env && set +a  (Mac/Linux)
#                           or manually set env vars in Windows

# REQUIRED: The "MAIL FROM" address used in SMTP handshakes.
# Use a domain you own with a valid MX record, or a domain whose mail
# server won't reject outbound SMTP probes (e.g. your company domain).
MAIL_FROM=verify@yourdomain.com

# OPTIONAL: Cap total greylisting wait time in seconds (default: 90).
# Prevents a single greylisted email from blocking a batch for 6+ minutes.
MAX_GREYLIST_WAIT=90
